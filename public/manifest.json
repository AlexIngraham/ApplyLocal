{
  "manifest_version": 3,
  "name": "ApplyLocal",
  "version": "0.1.0",
  "description": "Privacy-conscious job application autofill. Your profile stays on this device.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "ApplyLocal",
    "default_popup": "src/ui/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://*.lever.co/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
